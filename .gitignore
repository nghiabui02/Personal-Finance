# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

#IDE
.idea
.vscode

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# local MCP server config — not a secret by itself, but keep it out of the
# repo so a shared/public clone doesn't come pre-wired with a Supabase MCP
# endpoint for this project
.mcp.json

# AI agent instructions — local only, not shared in the repo
AGENTS.md
CLAUDE.md

# typescript
*.tsbuildinfo
next-env.d.ts
.DS_Store